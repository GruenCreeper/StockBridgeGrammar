<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../StockBridgeGrammar/Core/GrammarRules.cs" Link="Core/GrammarRules.cs" />
    <Compile Include="../../StockBridgeGrammar/Core/SpatialStockNode.cs" Link="Core/SpatialStockNode.cs" />
    <Compile Include="../../StockBridgeGrammar/Core/CandidateGenerator.cs" Link="Core/CandidateGenerator.cs" />
    <Compile Include="../../StockBridgeGrammar/Core/Assigner.cs" Link="Core/Assigner.cs" />
    <Compile Include="../../StockBridgeGrammar/Core/JsonIO.cs" Link="Core/JsonIO.cs" />
    <Compile Include="../../StockBridgeGrammar/Core/StockInventory.cs" Link="Core/StockInventory.cs" />
    <Compile Include="../../StockBridgeGrammar/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <None Include="../../StockBridgeGrammar/examples/add_node_spatial/*.json" Link="examples/add_node_spatial/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
